# Long random string; required. Generate one with: openssl rand -hex 32
CLOCKWORK_TOKEN=
CLOCKWORK_AGENT_TOKEN=
CLOCKWORK_INGEST_TOKEN=
# Optional: enables the teacher.
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default) or claude-haiku-5-5 for lower cost.
CLOCKWORK_TEACHER_MODEL=

# Who labels what the local model is unsure about: builtin (model key above) or agent (the user's own agent over MCP).
CLOCKWORK_TEACHER_MODE=builtin
# With the built-in teacher on, also let the agent label (including "ignore"): 1
CLOCKWORK_AGENT_TEACHER=
# The user's timezone, for reading times written in messages.
CLOCKWORK_TZ=UTC
# Public https address of this instance. Setting it switches on OAuth sign-in for agents such as ChatGPT (see README).
# CLOCKWORK_PUBLIC_URL=https://your-instance.example
